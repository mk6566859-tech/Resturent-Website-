PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGODB_DNS_SERVERS=8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
